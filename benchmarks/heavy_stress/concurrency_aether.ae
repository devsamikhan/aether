let ch = channel()
let t0 = time()
spawn {
    let i = 0
    while i < 500000:
        send(ch, i)
        i = i + 1
}
let sum = 0
let j = 0
while j < 500000:
    sum = sum + recv(ch)
    j = j + 1
let t1 = time()
println("AETHER Concurrency Sum:", sum)
println("AETHER Concurrency Time:", (t1 - t0) * 1000.0, "ms")
