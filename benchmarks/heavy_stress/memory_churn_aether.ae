let n = 500000
let t0 = time()
let i = 0
let node = nil
let sum = 0
while i < n:
    node = { "val": i, "tag": 1 }
    sum = sum + node["val"]
    i = i + 1
let t1 = time()
println("AETHER Heap Allocation Churn (500k Nodes):")
println("  Sum:", sum)
println("  Time:", (t1 - t0) * 1000.0, "ms")
println("  Rate:", int(n / (t1 - t0)), "allocations/sec")
