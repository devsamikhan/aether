# ==============================================================================
# AetherRPC & AetherPack — Zero-Copy Binary Serialization & Microservice RPC
# ==============================================================================

class AetherPack:
    def pack(val):
        return __native_rpc.pack(val)

    def unpack(bytes_val):
        return __native_rpc.unpack(bytes_val)

    def to_hex(val):
        return __native_rpc.pack_hex(val)

    def from_hex(hex_str):
        return __native_rpc.unpack_hex(str(hex_str))

    def stats(val):
        return __native_rpc.stats(val)

class RpcServer:
    def __init__(self, port, host="127.0.0.1"):
        self.host = str(host)
        self.port = int(port)
        self.id = __native_rpc.server_create(self.port, self.host)
        self.handlers = {}
        self.total_served = 0

    def register(self, method_name, handler):
        self.handlers[str(method_name)] = handler
        return true

    def serve_once(self, timeout_ms=300):
        let req = __native_rpc.server_poll(self.id, int(timeout_ms))
        if req == nil:
            return false

        let call_id = req["call_id"]
        let method = req["method"]
        let args = req["args"]

        if method in self.handlers:
            let fn_handler = self.handlers[method]
            let result = fn_handler(args)
            __native_rpc.server_respond(call_id, "ok", result)
            self.total_served = self.total_served + 1
            return true
        else:
            __native_rpc.server_respond(call_id, "error", "Method '" + str(method) + "' not registered on RPC server")
            return true

    def serve_all(self, max_requests=10, timeout_ms=200):
        let count = 0
        let i = 0
        while i < max_requests:
            let served = self.serve_once(timeout_ms)
            if served:
                count = count + 1
            else:
                return count
            i = i + 1
        return count

    def close(self):
        return __native_rpc.server_close(self.id)

class RpcClient:
    def __init__(self, port, host="127.0.0.1"):
        self.host = str(host)
        self.port = int(port)
        self.id = __native_rpc.client_connect(self.port, self.host)
        self.is_connected = true

    def call(self, method_name, args=[], timeout_ms=5000):
        return __native_rpc.client_call(self.id, str(method_name), args, int(timeout_ms))

    def close(self):
        self.is_connected = false
        return __native_rpc.client_close(self.id)
