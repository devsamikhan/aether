        self.max_depth = max_depth
        self.seed = seed
        self.id = nil

    def fit(self, X, y):
        self.id = __native_ml.random_forest_fit(X, y, self.n_estimators, self.max_depth, self.seed)
        return self

    def predict(self, X):
        return __native_ml.predict(self.id, X)

    def score(self, X, y):
        return __native_ml.accuracy(y, self.predict(X))

    def save(self, path):
        return __native_ml.save_model(self.id, path)

