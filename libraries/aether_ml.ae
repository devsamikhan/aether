class KMeans:
    def __init__(self, k=3, max_iter=100, seed=42):
        self.k = k
        self.max_iter = max_iter
        self.seed = seed
        self.id = nil

    def fit(self, X):
        self.id = __native_ml.kmeans_fit(X, self.k, self.max_iter, self.seed)
        return self

    def predict(self, X):
        return __native_ml.predict(self.id, X)

    def centroids(self):
        return __native_ml.kmeans_centroids(self.id)

class PCA:
    def __init__(self, n_components=2):
        self.n_components = n_components
        self.id = nil

    def fit(self, X):
        self.id = __native_ml.pca_fit(X, self.n_components)
        return self

    def transform(self, X):
        return __native_ml.transform(self.id, X)

    def fit_transform(self, X):
        self.fit(X)
        return self.transform(X)

    def explained_variance(self):
        return __native_ml.pca_explained_variance(self.id)

def train_test_split(X, y, test_ratio=0.2, seed=42):
    return __native_ml.train_test_split(X, y, test_ratio, seed)

def load_model(path):
    return __native_ml.load_model(path)
