class LinearRegression:
    def __init__(self, l2=0.000001):
        self.l2 = l2
        self.id = nil

    def fit(self, X, y):
        self.id = __native_ml.linear_regression_fit(X, y, self.l2)
        return self

    def predict(self, X):
        return __native_ml.predict(self.id, X)

    def weights(self):
        return __native_ml.linear_weights(self.id)

    def score(self, X, y):
        let preds = self.predict(X)
        return __native_ml.r2_score(y, preds)

    def save(self, path):
        return __native_ml.save_model(self.id, path)

class LogisticRegression:
    def __init__(self, lr=0.1, epochs=400, l2=0.0001):
        self.lr = lr
        self.epochs = epochs
        self.l2 = l2
        self.id = nil

    def fit(self, X, y):
        self.id = __native_ml.logistic_regression_fit(X, y, self.lr, self.epochs, self.l2)
        return self

    def predict(self, X):
        return __native_ml.predict(self.id, X)

    def predict_proba(self, X):
        return __native_ml.predict_proba(self.id, X)

    def score(self, X, y):
        let preds = self.predict(X)
        return __native_ml.accuracy(y, preds)

    def save(self, path):
        return __native_ml.save_model(self.id, path)

class DecisionTree:
    def __init__(self, max_depth=6, min_samples_split=2):
        self.max_depth = max_depth
        self.min_samples_split = min_samples_split
        self.id = nil

    def fit(self, X, y):
        self.id = __native_ml.decision_tree_fit(X, y, self.max_depth, self.min_samples_split)
        return self

    def predict(self, X):
        return __native_ml.predict(self.id, X)

    def score(self, X, y):
        return __native_ml.accuracy(y, self.predict(X))

    def save(self, path):
        return __native_ml.save_model(self.id, path)

class RandomForest:
    def __init__(self, n_estimators=15, max_depth=6, seed=42):
