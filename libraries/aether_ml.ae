class StandardScaler:
    def __init__(self):
        self.id = nil

    def fit(self, X):
        self.id = __native_ml.standard_scaler_fit(X)
        return self

    def transform(self, X):
        return __native_ml.transform(self.id, X)

    def fit_transform(self, X):
        self.fit(X)
        return self.transform(X)

    def save(self, path):
        return __native_ml.save_model(self.id, path)

class MinMaxScaler:
