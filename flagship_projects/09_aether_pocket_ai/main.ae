# 1. Initialize On-Device Autonomous Agent
let agent = AI.Agent("PocketCopilot", "Autonomous Mobile Assistant")
agent.add_knowledge("AETHER 2.0 combines Python simplicity with native Cranelift execution speed.")
agent.add_knowledge("AetherBridge allows direct native hardware access to Camera, GPS, Notifications, and Alarms.")
agent.add_knowledge("P2P Swarm enables instant zero-config LAN mesh synchronization.")

# 2. Test Local Semantic Inference
let test_query = "What hardware features does AETHER support?"
print(f"🧠 Querying Local Neural Agent: '{test_query}'")
let reply = agent.chat(test_query)
print(f"🤖 Response: {reply}\n")

# 3. Test Vector Embeddings
let emb = AI.embed("Pocket AI autonomous assistant")
print(f"📊 Generated 128-D Semantic Embedding: Vector magnitude L2 normalized (Dims: {len(emb)})")

# 4. Initialize Local In-Memory Relational DB for Notes & Logs
let db = DB.open("data/pocket_ai.db")
db.execute("CREATE TABLE IF NOT EXISTS notes (id INT, title TEXT, content TEXT, synced INT);")
db.execute("INSERT INTO notes (id, title, content, synced) VALUES (1, 'Architectural Invariant', 'Zero SDKs, pure Rust standard library', 1);")
db.execute("INSERT INTO notes (id, title, content, synced) VALUES (2, 'Mesh Beaconing', 'Swarm broadcasting on UDP 19892', 1);")

let all_notes = db.query("SELECT * FROM notes;")
print(f"📝 Local Encrypted Notes in Database: {len(all_notes)}")
for n in all_notes:
    print(f"   • [Note #{n['id']}] {n['title']}: {n['content']}")

