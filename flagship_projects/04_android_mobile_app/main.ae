# ==============================================================================
# Flagship Project 04: AetherPocket (Mobile Fitness & Productivity App)
# Powered by Google Material 3 (M3 / Material You) & AETHER Mobile Engine
# Features:
#   - Google Material 3 Dynamic Tonal Theming (M3.theme)
#   - M3 Elevated & Filled Cards, Chips, Badges, FAB & NavigationBar
#   - Pythonic F-strings: f"..."
#   - Pipeline Operators: |>
#   - Android Device Hardware APIs (Haptics, Battery, Network, Toasts)
# ==============================================================================

# 1. Utility pipelines for fitness metrics
def clean_sensor_jitter(val):
    if val < 0:
        return 0
    return val

def apply_step_calibration(steps):
    return steps * 1.05

def steps_to_calories(steps):
    return steps * 0.04

def format_percentage(ratio):
    pct = int(ratio * 100.0)
    if pct > 100:
        pct = 100
    return f"{pct}%"

# 2. Material 3 Progress Indicator Widget
class M3ProgressBar:
    def __init__(self, current, target, unit):
        self.current = current
        self.target = target
        self.unit = unit

    def progress_bar_str(self):
        ratio = (self.current * 1.0) / self.target
        filled = int(ratio * 20.0)
        if filled > 20:
            filled = 20
        if filled < 0:
            filled = 0
        empty = 20 - filled
        bar = ("█" * filled) + ("░" * empty)
        pct = format_percentage(ratio)
        return f"|{bar}| {pct} ({self.current}/{self.target} {self.unit})"

# 3. Mobile Application State Container with Material 3 Integration
class AetherPocketApp:
    def __init__(self, user_name, step_goal, water_goal_ml):
        self.app_title = "AetherPocket Mobile"
        self.user_name = user_name
        self.step_goal = step_goal
        self.water_goal_ml = water_goal_ml
        self.current_steps = 0
        self.current_water_ml = 0
        self.completed_tasks = []
        self.active_tab = "Home"

        # Initialize Google Material 3 Theme with AETHER Cyan Seed
        self.theme = M3.theme("#00F5FF", True)
        self.battery = Mobile.battery_level()
        self.device = Mobile.device_info()
        self.network = Mobile.network_status()

    def bootstrap(self):
        Mobile.set_title(self.app_title)
        Mobile.show_toast(f"Welcome back, {self.user_name}!")
        print("================================================================")
        print(f"   ⚡ {self.app_title} - Google Material 3 Edition ⚡")
        print("================================================================")
        print(f"🎨 M3 Seed Color:      {self.theme['seed']} (Tonal Dynamic Palette)")
        print(f"🎨 M3 Primary:         {self.theme['primary']}  |  On-Primary: {self.theme['on_primary']}")
        print(f"🎨 M3 Surface:         {self.theme['surface']}  |  Container:  {self.theme['primary_container']}")
        print(f"📱 Running on:         {self.device['brand']} {self.device['model']}")
        print(f"⚙️ Android OS:         {self.device['os']} ({self.device['arch']})")
        print(f"🔋 Battery Level:      {self.battery}%  |  Network: {self.network}")
        print("----------------------------------------------------------------\n")

    def record_steps(self, raw_steps):
        # AETHER pipeline operator for sensor data
        calibrated = raw_steps |> clean_sensor_jitter |> apply_step_calibration
        self.current_steps = self.current_steps + int(calibrated)
        
        # Trigger Android haptic vibration
        Mobile.vibrate(25)
        
        cals = self.current_steps |> steps_to_calories
        print(f"👟 Step Update: +{int(calibrated)} steps (Total: {self.current_steps})")
        print(f"🔥 Calories Burned: {cals:.1f} kcal")

    def drink_water(self, amount_ml):
        self.current_water_ml = self.current_water_ml + amount_ml
        Mobile.vibrate(40)
        Mobile.show_toast(f"+{amount_ml}ml logged. Keep hydrating!")
        print(f"💧 Hydration Logged: {self.current_water_ml}ml / {self.water_goal_ml}ml")

    def complete_task(self, title):
        self.completed_tasks.append(title)
        Mobile.vibrate(80)
        Mobile.show_toast(f"Task completed: {title}")
        print(f"✅ Completed: {title}")

    def render_m3_screen(self):
        print("\n================== [GOOGLE MATERIAL 3 MOBILE UI] ==================")
        
        # 1. Top App Bar
        top_bar = M3.top_app_bar(self.app_title, f"User: {self.user_name}")
        M3.render_preview(top_bar)

        # 2. Filter Chips row
        print("\n M3 FilterChips:")
        chip1 = M3.chip("Cardio & Steps", True, "👟")
        chip2 = M3.chip("Hydration", True, "💧")
        chip3 = M3.chip("Core Workout", len(self.completed_tasks) > 0, "💪")
        print(f"   [✓ {chip1['label']}]   [✓ {chip2['label']}]   [{'✓' if chip3['selected'] else '○'} {chip3['label']}]")

        # 3. M3 Elevated Card for Daily Steps
        step_pb = M3ProgressBar(self.current_steps, self.step_goal, "steps")
        cals = self.current_steps |> steps_to_calories
        card1 = M3.card(
            "elevated",
            "Daily Steps & Calories",
            "Activity Sensor Goal",
            f"Progress: {step_pb.progress_bar_str()} | Burn: {cals:.1f} kcal"
        )
        M3.render_preview(card1)

        # 4. M3 Filled Card for Hydration
        water_pb = M3ProgressBar(self.current_water_ml, self.water_goal_ml, "ml")
        card2 = M3.card(
            "filled",
            "Hydration Target",
            "Optimal Daily Intake",
            f"Logged: {water_pb.progress_bar_str()}"
        )
        M3.render_preview(card2)

        # 5. M3 Buttons & FAB
        print("\n Interactive Actions:")
        btn_workout = M3.filled_button("Log Hydration (+250ml)", "💧")
        M3.render_preview(btn_workout)

        fab = M3.fab("add", "New Activity", True)
        M3.render_preview(fab)

        # 6. M3 Bottom Navigation Bar
        nav_items = [
            {"label": "Home", "icon": "home", "active": True},
            {"label": "Activity", "icon": "fitness", "active": False},
            {"label": "Insights", "icon": "analytics", "active": False},
            {"label": "Profile", "icon": "person", "active": False}
        ]
        nav_bar = M3.navigation_bar(nav_items)
        M3.render_preview(nav_bar)

        print("\n Recent Activity Log:")
        if len(self.completed_tasks) == 0:
            print("   (No habits logged yet today)")
        else:
            for t in self.completed_tasks:
                print(f"   • {t}")
        print("===================================================================\n")

# 4. Mobile Execution Simulation
def main():
    app = AetherPocketApp("Sami Khan", 10000, 2500)
    app.bootstrap()

    # User interacts with mobile touch UI
    print(">>> [User Action] User walks during morning commute...")
    app.record_steps(3420)

    print("\n>>> [User Action] User drinks a glass of water...")
    app.drink_water(350)

    print("\n>>> [User Action] User walks after lunch...")
    app.record_steps(4810)

    print("\n>>> [User Action] User completes daily workout task...")
    app.drink_water(500)
    app.complete_task("30-minute Cardio & Core Workout")
    app.complete_task("Read 15 pages of Compiler Architecture")

    # Render complete Google Material 3 screen view
    app.render_m3_screen()

    print("✨ AETHER Google Material 3 Mobile Application executed successfully!")

main()
