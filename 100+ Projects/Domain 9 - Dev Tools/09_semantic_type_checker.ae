// Project 9: Semantic Type Checker
// Validates operand compatibility during semantic analysis phase.

fn check_binary_op_types(left_type, op, right_type) {
    if op == "+" {
        if left_type == "INT" && right_type == "INT" { return "INT" }
        if left_type == "STRING" && right_type == "STRING" { return "STRING" }
        if left_type == "FLOAT" && right_type == "FLOAT" { return "FLOAT" }
        return "TYPE_ERROR_MISMATCH"
    }
    if op == "==" {
        if left_type == right_type { return "BOOL" }
        return "TYPE_ERROR_MISMATCH"
    }
    return "UNKNOWN_OPERATOR"
}

fn main() {
    let t1 = check_binary_op_types("INT", "+", "INT")
    let t2 = check_binary_op_types("STRING", "+", "STRING")
    let t3 = check_binary_op_types("INT", "+", "STRING")
    
    println("🛡️ Semantic Type Checking:")
    println("  INT + INT -> " + t1)
    println("  STRING + STRING -> " + t2)
    println("  INT + STRING -> " + t3)
    
    assert(t1 == "INT", "INT + INT must produce INT")
    assert(t2 == "STRING", "STRING + STRING must produce STRING")
    assert(t3 == "TYPE_ERROR_MISMATCH", "INT + STRING must raise type mismatch")
    println("✅ Semantic Type Checker Verified.")
}

main()
