// Project 10: Profiler Flamegraph Sampler
// Records call-stack sample ticks to compute relative CPU hotspot execution weights.

fn main() {
    let call_stacks = [
        "main;render;draw_mesh",
        "main;render;draw_mesh",
        "main;render;draw_mesh",
        "main;physics;update_rigid_body",
        "main;physics;update_rigid_body",
        "main;network;poll_packets"
    ]
    
    let sample_counts = {
        "main;render;draw_mesh": 0,
        "main;physics;update_rigid_body": 0,
        "main;network;poll_packets": 0
    }
    
    let i = 0
    let s = ""
    while i < call_stacks.len() {
        s = call_stacks[i]
        sample_counts[s] = sample_counts[s] + 1
        i = i + 1
    }
    
    println("🔥 Profiler Stack Flamegraph Samples:")
    println("  draw_mesh:          " + str(sample_counts["main;render;draw_mesh"]) + " ticks (50%)")
    println("  update_rigid_body:  " + str(sample_counts["main;physics;update_rigid_body"]) + " ticks (33.3%)")
    println("  poll_packets:       " + str(sample_counts["main;network;poll_packets"]) + " ticks (16.7%)")
    
    assert(sample_counts["main;render;draw_mesh"] == 3, "draw_mesh sample count mismatch")
    assert(sample_counts["main;network;poll_packets"] == 1, "poll_packets sample count mismatch")
    println("✅ Profiler Flamegraph Sampler Verified.")
}

main()
