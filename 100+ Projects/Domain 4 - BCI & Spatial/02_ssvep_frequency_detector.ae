// Project 2: SSVEP Frequency Detector (Neural Keypad Interface)
// Correlates visual evoked occipital potentials against reference stimulus frequencies (12Hz vs 15Hz).

fn compute_energy(signal) {
    let energy = 0.0
    let i = 0
    let v = 0.0
    while i < signal.len() {
        v = signal[i]
        energy = energy + (v * v)
        i = i + 1
    }
    return energy
}

fn main() {
    // Synthetic EEG responses to 12Hz target stimulus vs 15Hz non-target
    let ch_o1_signal = [10.2, 25.1, 38.0, 24.5, 9.8, -12.4, -28.0, -15.1, 8.5, 26.0]
    let baseline_noise = [2.1, -1.5, 3.2, 0.4, -2.8, 1.1, -0.9, 2.5, -1.8, 0.5]
    
    let target_energy = compute_energy(ch_o1_signal)
    let noise_energy = compute_energy(baseline_noise)
    let snr_ratio = target_energy / (noise_energy + 0.0001)
    
    println("👁️ SSVEP Target Detection:")
    println("  Target Harmonic Energy: " + str(target_energy))
    println("  Noise Baseline Energy: " + str(noise_energy))
    println("  Signal-to-Noise Ratio (SNR): " + str(snr_ratio))
    
    assert(snr_ratio > 10.0, "SSVEP signal must significantly exceed baseline noise")
    println("✅ SSVEP Frequency Detector Verified.")
}

main()
