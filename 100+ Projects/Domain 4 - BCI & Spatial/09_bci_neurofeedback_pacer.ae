// Project 9: BCI Neurofeedback Pacer (Theta / Beta Ratio)
// Monitors attentional relaxation by computing frontal midline Theta / Beta power ratio.

fn main() {
    // 5-second windows of Theta (4-7Hz) and Beta (13-20Hz) spectral power
    let theta_power = [14.0, 18.2, 22.5, 26.0, 30.1]
    let beta_power  = [35.0, 31.0, 24.2, 19.5, 15.0]
    
    let i = 0
    let t_pow = 0.0
    let b_pow = 0.0
    let tbr = 0.0
    let state = ""
    
    println("🧘 Neurofeedback Mindfulness Pacer:")
    while i < theta_power.len() {
        t_pow = theta_power[i]
        b_pow = beta_power[i]
        tbr = t_pow / b_pow
        
        if tbr > 1.5 {
            state = "DEEP_MEDITATION"
        } else if tbr > 0.8 {
            state = "CALM_RELAXED"
        } else {
            state = "ACTIVE_ANXIOUS"
        }
        
        println("  Window " + str(i + 1) + " -> TBR: " + str(tbr) + " | State: " + state)
        i = i + 1
    }
    
    assert(state == "DEEP_MEDITATION", "Final state must reach meditative threshold")
    println("✅ BCI Neurofeedback Pacer Verified.")
}

main()
