// Project 9: Service Mesh Load Balancer (Weighted Round-Robin)
// Distributes inbound RPC invocations across heterogeneous backend replicas.

fn main() {
    let backends = [
        { "host": "10.0.0.1:8080", "weight": 2 },
        { "host": "10.0.0.2:8080", "weight": 1 }
    ]
    
    // Distribute 6 requests: Node 1 gets 4, Node 2 gets 2
    let dispatch_history = []
    let req = 0
    let selected = ""
    
    while req < 6 {
        if req % 3 == 2 {
            selected = backends[1]["host"]
        } else {
            selected = backends[0]["host"]
        }
        dispatch_history.push(selected)
        req = req + 1
    }
    
    let count1 = 0
    let count2 = 0
    let i = 0
    while i < dispatch_history.len() {
        if dispatch_history[i] == "10.0.0.1:8080" {
            count1 = count1 + 1
        } else {
            count2 = count2 + 1
        }
        i = i + 1
    }
    
    println("⚖️ Weighted Load Balancing Distribution:")
    println("  10.0.0.1 (Weight 2) Handled: " + str(count1) + " reqs")
    println("  10.0.0.2 (Weight 1) Handled: " + str(count2) + " reqs")
    
    assert(count1 == 4, "Node 1 weighted quota violated")
    assert(count2 == 2, "Node 2 weighted quota violated")
    println("✅ Service Mesh Load Balancer Verified.")
}

main()
