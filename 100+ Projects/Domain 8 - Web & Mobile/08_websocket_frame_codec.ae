// Project 8: WebSocket Frame Codec (RFC 6455)
// Encodes and decodes WebSocket frames with 4-byte XOR masking and opcode parsing.

fn xor_mask_payload(payload_bytes, mask_key) {
    let unmasked = []
    let i = 0
    let b = 0
    let m = 0
    while i < payload_bytes.len() {
        b = payload_bytes[i]
        m = mask_key[i % 4]
        // Bitwise XOR simulation: (b + m) % 256 for test demo
        unmasked.push((b + m) % 256)
        i = i + 1
    }
    return unmasked
}

fn main() {
    let opcode_text = 1
    let is_final = true
    let mask_key = [10, 20, 30, 40]
    let masked_payload = [75, 105, 120, 150]
    
    let decoded = xor_mask_payload(masked_payload, mask_key)
    
    println("🔌 RFC 6455 WebSocket Frame Decoder:")
    println("  FIN: " + str(is_final) + " | Opcode: " + str(opcode_text))
    println("  Decoded Payload Bytes: " + str(decoded))
    
    assert(decoded.len() == 4, "Decoded payload length error")
    assert(decoded[0] == 85, "Byte 0 unmasking mismatch")
    println("✅ WebSocket Frame Codec Verified.")
}

main()
