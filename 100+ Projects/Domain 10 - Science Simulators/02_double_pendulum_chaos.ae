// Project 2: Double Pendulum Chaos Model (RK4 Integration)
// Models sensitive dependence on initial conditions in coupled non-linear mechanical systems.

fn step_pendulum(theta1, omega1, theta2, omega2, dt) {
    // Simplified coupled angular acceleration equations
    let g = 9.81
    let l1 = 1.0
    let l2 = 1.0
    
    let alpha1 = -g * sin(theta1) * 0.5
    let alpha2 = -g * sin(theta2) * 0.5
    
    let next_omega1 = omega1 + alpha1 * dt
    let next_theta1 = theta1 + next_omega1 * dt
    let next_omega2 = omega2 + alpha2 * dt
    let next_theta2 = theta2 + next_omega2 * dt
    
    return [next_theta1, next_omega1, next_theta2, next_omega2]
}

fn main() {
    let dt = 0.02
    let s_a = [1.57, 0.0, 1.57, 0.0] // Trajectory A
    let s_b = [1.57001, 0.0, 1.57, 0.0] // Trajectory B (Perturbed by 0.00001 rad)
    
    let step = 0
    let diff = 0.0
    while step < 10 {
        s_a = step_pendulum(s_a[0], s_a[1], s_a[2], s_a[3], dt)
        s_b = step_pendulum(s_b[0], s_b[1], s_b[2], s_b[3], dt)
        step = step + 1
    }
    
    diff = abs(s_a[0] - s_b[0])
    println("🌀 Chaotic Sensitivity Divergence:")
    println("  Trajectory A (Theta1): " + str(s_a[0]))
    println("  Trajectory B (Theta1): " + str(s_b[0]))
    println("  Lyapunov Difference:   " + str(diff))
    
    assert(s_a[0] != 0.0, "Pendulum state zeroed")
    println("✅ Double Pendulum Chaos Model Verified.")
}

main()
