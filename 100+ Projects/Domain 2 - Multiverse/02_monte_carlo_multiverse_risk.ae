// Project 2: Monte Carlo Multiverse Risk Simulator
// Simulates 100 parallel universes to evaluate downside risk and expected portfolio return.

fn lcg_next(state) {
    return (state * 1103515245 + 12345) % 2147483648
}

fn main() {
    let num_universes = 100
    let initial_capital = 10000.0
    let outcomes = []
    let seed = 42
    let u = 0
    let capital = 0.0
    let step = 0
    let rand_val = 0
    let return_pct = 0.0
    let total_capital = 0.0
    let max_val = 0.0
    let min_val = 99999999.0
    let curr = 0.0
    
    while u < num_universes {
        capital = initial_capital
        step = 0
        while step < 10 {
            seed = lcg_next(seed)
            rand_val = seed % 100
            if rand_val > 52 {
                return_pct = 1.05
            } else {
                return_pct = 0.96
            }
            capital = capital * return_pct
            step = step + 1
        }
        outcomes.push(capital)
        total_capital = total_capital + capital
        u = u + 1
    }
    
    let mean_outcome = total_capital / num_universes
    u = 0
    while u < outcomes.len() {
        curr = outcomes[u]
        if curr > max_val { max_val = curr }
        if curr < min_val { min_val = curr }
        u = u + 1
    }
    
    println("🎲 Monte Carlo Multiverse Simulation (100 Universes):")
    println("  Initial Capital: $" + str(initial_capital))
    println("  Mean Terminal Capital: $" + str(mean_outcome))
    println("  Best Universe: $" + str(max_val))
    println("  Worst Universe: $" + str(min_val))
    
    assert(outcomes.len() == 100, "100 universes required")
    assert(mean_outcome > 5000.0, "Portfolio mean value out of plausible bounds")
    println("✅ Multiverse Risk Simulator Verified.")
}

main()
