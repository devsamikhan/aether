mod prime;
mod matrix;
mod crdt_consensus;
mod quantum_teleport;
mod fibonacci;
mod data_science;

use prime::PrimeGenerator;
use matrix::MatrixOps;
use crdt_consensus::CrdtConsensus;
use quantum_teleport::QuantumTeleportation;
use fibonacci::Fibonacci;
use data_science::DataScienceApp;

intent AetherRunner {
    fn main() {
        println("=== AETHER Multi-Program Compilation Verification ===");
        
        // 1. Prime Number Verification
        let prime = PrimeGenerator();
        prime.print_primes_up_to(10);
        
        // 2. Matrix operations simulation
        let matrix = MatrixOps();
        matrix.test_tensor_ops();
        
        // 3. Replicated consensus simulation
        let consensus = CrdtConsensus();
        consensus.verify_agreement();
        
        // 4. Quantum state teleportation
        let teleport = QuantumTeleportation();
        teleport.run_teleport();
        
        // 5. Fibonacci iteration sequence
        let fib = Fibonacci();
        fib.fib_iterative(8);

        // 6. Python Interop Data Science Pipeline
        let ds = DataScienceApp();
        ds.run_analytics();
        
        println("=== All 6 AETHER Programs Executed Successfully ===");
    }
}