pub intent PrimeGenerator {
    pub fn is_prime(n: Int) -> Bool {
        if n <= 1 {
            return false;
        }
        for i in 2..n {
            if n % i == 0 {
                return false;
            }
        }
        return true;
    }

    pub fn print_primes_up_to(limit: Int) {
        println("Prime numbers up to " + limit + ":");
        for i in 2..limit {
            if is_prime(i) {
                println("  Prime found: " + i);
            }
        }
    }
}
