# ----------------------------------------------------
# 1. High-Performance Matrix Class with Operator Overloading
# ----------------------------------------------------
class Matrix:
    def __init__(self, rows, cols, default_val=0.0):
        self.rows = rows
        self.cols = cols
        self.data = []
        r = 0
        while r < rows:
            row = []
            c = 0
            while c < cols:
                append(row, default_val)
                c += 1
            append(self.data, row)
            r += 1

    def get(self, r, c):
        return self.data[r][c]

    def set(self, r, c, val):
        self.data[r][c] = val

    def __add__(self, other):
        # Element-wise addition with row/column broadcasting
        result = Matrix(self.rows, self.cols, 0.0)
        r = 0
        while r < self.rows:
            other_r = r
            if other.rows == 1:
                other_r = 0
            c = 0
            while c < self.cols:
                other_c = c
                if other.cols == 1:
                    other_c = 0
                sum_val = self.data[r][c] + other.data[other_r][other_c]
                result.set(r, c, sum_val)
                c += 1
            r += 1
        return result

    def __mul__(self, other):
        # Dot product / Matrix multiplication: (R1 x C1) * (C1 x C2) -> (R1 x C2)
        result = Matrix(self.rows, other.cols, 0.0)
        r = 0
        while r < self.rows:
            c = 0
            while c < other.cols:
                dot_sum = 0.0
                k = 0
                while k < self.cols:
                    dot_sum += self.data[r][k] * other.data[k][c]
                    k += 1
                result.set(r, c, dot_sum)
                c += 1
            r += 1
        return result

    def __str__(self):
        s = "Matrix(" + str(self.rows) + "x" + str(self.cols) + ") [\n"
        r = 0
        while r < self.rows:
            s = s + "  ["
            c = 0
            while c < self.cols:
                if c > 0:
                    s = s + ", "
                s = s + str(self.data[r][c])
                c += 1
            s = s + "]\n"
            r += 1
        return s + "]"

# ----------------------------------------------------
# 2. Activation Functions
# ----------------------------------------------------
def relu(x):
    if x > 0.0:
        return x
    return 0.0

def activate_matrix(mat):
    activated = Matrix(mat.rows, mat.cols, 0.0)
    r = 0
    while r < mat.rows:
        c = 0
        while c < mat.cols:
            val = relu(mat.get(r, c))
            activated.set(r, c, val)
            c += 1
        r += 1
    return activated

# ----------------------------------------------------
# 3. Dense Neural Network Layer
# ----------------------------------------------------
class DenseLayer:
    def __init__(self, in_features, out_features, name="Dense"):
        self.name = name
        self.in_features = in_features
        self.out_features = out_features
        
        # Deterministic Xavier/Glorot weight initialization
        self.weights = Matrix(in_features, out_features, 0.0)
        scale = 1.0 / float(in_features)
        r = 0
        while r < in_features:
            c = 0
            while c < out_features:
                # Deterministic pattern generating varied weights
                w = ((float(r * 3 + c * 7 + 5) % 10.0) - 5.0) * scale * 0.5
                self.weights.set(r, c, w)
                c += 1
            r += 1

        self.biases = Matrix(1, out_features, 0.1)

    def forward(self, inputs):
        # Z = (Inputs * Weights) + Biases
        linear_output = (inputs * self.weights) + self.biases
        return activate_matrix(linear_output)

# ----------------------------------------------------
# 4. Multi-Layer Neural Network
# ----------------------------------------------------
class SequentialNeuralNet:
    def __init__(self):
        self.layers = []

    def add(self, layer):
        append(self.layers, layer)

    def predict(self, input_batch):
        current = input_batch
        for layer in self.layers:
            current = layer.forward(current)
        return current

# ----------------------------------------------------
# 5. Model Architecture & Inference
# ----------------------------------------------------
print("\n--- 1. Assembling 2-Layer Neural Network ---")
# Input dimension: 4 (features: e.g. latency, error_rate, cpu, memory)
# Hidden layer: 8 neurons
# Output layer: 2 neurons (Category A vs Category B classification)

model = SequentialNeuralNet()
model.add(DenseLayer(4, 8, name="Hidden_Layer_1"))
model.add(DenseLayer(8, 2, name="Output_Classifier"))

print("Architecture: Input(4) -> Dense(8, ReLU) -> Output(2, Softmax/Argmax)")

# Single sample test
sample = Matrix(1, 4, 0.0)
sample.set(0, 0, 1.2)  # Feature 1
sample.set(0, 1, 0.5)  # Feature 2
sample.set(0, 2, 2.8)  # Feature 3
sample.set(0, 3, 0.9)  # Feature 4

single_prediction = model.predict(sample)
print("Prediction on single sample:")
print(single_prediction)

# ----------------------------------------------------
# 6. High-Throughput Batch Inference Benchmark
# ----------------------------------------------------
BATCH_SIZE = 1000
print("\n--- 2. Batch Inference Benchmark (" + str(BATCH_SIZE) + " samples) ---")

batch_inputs = Matrix(BATCH_SIZE, 4, 0.0)
row = 0
while row < BATCH_SIZE:
    batch_inputs.set(row, 0, float((row * 13) % 100) / 50.0)
    batch_inputs.set(row, 1, float((row * 17) % 100) / 40.0)
    batch_inputs.set(row, 2, float((row * 19) % 100) / 30.0)
    batch_inputs.set(row, 3, float((row * 23) % 100) / 20.0)
    row += 1

start_time = clock()
batch_results = model.predict(batch_inputs)
elapsed = clock() - start_time

samples_per_sec = float(BATCH_SIZE) / elapsed

print("Batch inference finished in:", elapsed, "seconds")
print("Inference throughput:", int(samples_per_sec), "samples/second")
print("Output batch shape:", batch_results.rows, "rows x", batch_results.cols, "columns")
print("Sample prediction [Row 0]: [", batch_results.get(0, 0), ",", batch_results.get(0, 1), "]")
print("Sample prediction [Row 999]: [", batch_results.get(999, 0), ",", batch_results.get(999, 1), "]")

print("\n====================================================")
print("     Neural Network Benchmark Passed Successfully!  ")
print("====================================================")
