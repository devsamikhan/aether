# ==============================================================================
# AETHER 2.0 Showcase: AetherRPC Enterprise Microservice & TCP Mesh
# ==============================================================================
# Demonstrates:
#  1. Deploying a high-performance binary RPC Server on an isolated TCP port.
#  2. Registering multi-domain enterprise procedures (Auth, Pricing, AI Compute).
#  3. Dispatched client calls over persistent zero-copy TCP stream.
#  4. Catching and handling remote RPC method exceptions.
# ==============================================================================

from aether_rpc import RpcServer, RpcClient, AetherPack

print("================================================================================")
print("       AETHER 2.0: AETHERRPC ENTERPRISE MICROSERVICE DEMO                       ")
print("================================================================================")

# 1. Initialize RPC Server
let port = 19898
let server = RpcServer(port)
print("\n[Step 1] Initializing AetherRPC Server on 127.0.0.1:" + str(port) + "...")

# 2. Register Microservice Procedures
def auth_generate_session(args):
    let user_id = args[0]
    let role = args[1]
    return {
        "session_token": "aether-sess-" + str(user_id) + "-sec99",
        "user_id": user_id,
        "role": role,
        "expires_in_secs": 3600,
        "is_authenticated": true
    }

def billing_compute_invoice(args):
    let item_name = args[0]
    let unit_cents = args[1]
    let quantity = args[2]
    let discount_pct = args[3]
    let subtotal = unit_cents * quantity
    let discount = (subtotal * discount_pct) / 100
    let total = subtotal - discount
    return {
        "item": item_name,
        "quantity": quantity,
        "subtotal_cents": subtotal,
        "discount_cents": discount,
        "total_cents": total,
        "formatted_total": "$" + str(total / 100) + "." + str(total % 100)
    }

def ai_vector_dot(args):
    let v1 = args[0]
    let v2 = args[1]
    let sum = 0.0
    let i = 0
    while i < len(v1):
        sum = sum + (v1[i] * v2[i])
        i = i + 1
    return {
        "dot_product": sum,
        "dimensions": len(v1),
        "status": "COMPUTED_NATIVE"
    }

server.register("auth.generate_session", auth_generate_session)
server.register("billing.compute_invoice", billing_compute_invoice)
server.register("ai.vector_dot", ai_vector_dot)

print("  Registered RPC Methods:")
print("    * auth.generate_session(user_id, role)")
print("    * billing.compute_invoice(item_name, unit_cents, quantity, discount_pct)")
print("    * ai.vector_dot(vector_a, vector_b)")

# 3. Connect RPC Client over Persistent TCP Socket
print("\n[Step 2] Establishing Persistent TCP RPC Client Connection...")
let client = RpcClient(port)
print("  Client Connected: " + str(client.is_connected))

# 4. Dispatch Client Calls in Background
print("\n[Step 3] Invoking Multi-Domain Microservice Methods...")

spawn:
    # 1. Auth Service Call
    let auth_res = client.call("auth.generate_session", [10852, "cluster_admin"])
    print("\n  [RPC Response 1: auth.generate_session]")
    print("    Session Token:   " + auth_res["session_token"])
    print("    Authenticated:   " + str(auth_res["is_authenticated"]))
    print("    Role:            " + auth_res["role"])

    # 2. Billing Invoice Call
    let invoice_res = client.call("billing.compute_invoice", ["Aether Edge Isolate V2", 4500, 10, 15])
    print("\n  [RPC Response 2: billing.compute_invoice]")
    print("    Item:            " + invoice_res["item"])
    print("    Quantity:        " + str(invoice_res["quantity"]))
    print("    Discount:        " + str(invoice_res["discount_cents"]) + " cents")
    print("    Final Invoice:   " + invoice_res["formatted_total"])

    # 3. AI Vector Dot-Product
    let v_a = [1.2, 3.4, 5.6, 7.8]
    let v_b = [0.5, 2.0, 1.5, 0.5]
    let ai_res = client.call("ai.vector_dot", [v_a, v_b])
    print("\n  [RPC Response 3: ai.vector_dot]")
    print("    Dot Product:     " + str(ai_res["dot_product"]))
    print("    Dimensions:      " + str(ai_res["dimensions"]))
    print("    Status:          " + ai_res["status"])

# Server processes the 3 pending RPC calls
server.serve_once(1000)
server.serve_once(1000)
server.serve_once(1000)

print("\n[Step 4] Verifying Server Statistics...")
print("  Total RPC Requests Dispatched & Served: " + str(server.total_served))

# Cleanup
server.close()
client.close()

print("\n================================================================================")
print("  RESULT: AetherRPC microservices executed with zero-copy binary streaming!     ")
print("================================================================================")
