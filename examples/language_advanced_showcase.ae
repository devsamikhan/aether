// ==============================================================================
// AETHER Language Showcase: Functional Pipelines, Comptime, Async/Await & Task,
// Context Managers & LIFO Defer, Native Regex, Diagnostics, Formatter & Linter
// ==============================================================================

print("=== 1. Functional Collection Pipeline Methods ===")
let raw_scores = [45, 92, 78, 92, 60, 88, 100, 45]
let top_bonus_total = raw_scores.unique().sort().filter(|s| s >= 80).map(|s| s + 5).reduce(0, |acc, s| acc + s)
print("Top bonus total:", top_bonus_total)

print("\n=== 2. Compile-Time Execution (comptime) & Macros ===")
macro cube(n) {
    n * n * n
}
let FIB_TABLE = comptime {
    let mut seq = [0, 1]
    for i in 2..=8 {
        seq.push(seq[i - 1] + seq[i - 2])
    }
    seq
}
print("Precomputed FIB_TABLE at compile time:", FIB_TABLE)
print("macro cube(4):", cube(4))

print("\n=== 3. Async / Await & Structured Task Concurrency ===")
async fn compute_metric(n) {
    return n * n + 10
}
let t1 = Task.spawn(compute_metric, 6)
let t2 = Task.spawn(compute_metric, 9)
let results = Task.all([t1, t2])
print("Task.all results:", results)

print("\n=== 4. Deterministic Resource Management (with ... as ... & LIFO defer) ===")
let events = []
class Session {
    fn __init__(self, id) {
        self.id = id
    }
    fn __enter__(self) {
        events.push("open:" + self.id)
        return self
    }
    fn __exit__(self) {
        events.push("close:" + self.id)
    }
}

fn process_request() {
    defer events.push("cleanup:outer")
    defer events.push("cleanup:inner")
    with Session("sess-01") as s {
        events.push("query:" + s.id)
    }
    return "done"
}
let _ = process_request()
print("Lifecycle trace:", events.join(" -> "))

print("\n=== 5. Native Zero-Dependency Regex Engine ===")
let log_line = "2026-10-23 [ERROR] User #4091 failed login from 10.0.0.12"
print("Regex is_match:", Regex.is_match("^2026-[0-9]{2}-[0-9]{2}", log_line))
print("Regex find:", Regex.find("#[0-9]+", log_line))
print("Regex replace_all:", Regex.replace_all("[0-9]+", log_line, "X"))

print("\n=== 6. Built-in Code Formatter, Linter & Fuzzy Diagnostics ===")
let sample_code = "fn demo(a){\nlet unused_var = 42\nreturn a+1\n}\n"
print("Linter warnings:", Linter.lint(sample_code))
print("Fuzzy suggestion for 'prnt':", Diagnostics.suggest("prnt", ["print", "println", "len"]))

print("\n=== 7. Multi-Line Fluent Chaining & Pipeline Continuation ===")
let fluent_sum = [1, 2, 3, 4, 5, 6]
    .map(|x| x * 10)
    .filter(|x| x >= 30)
    .sum()
print("Multi-line fluent chain sum:", fluent_sum)

print("\n=== 8. Custom Iterators (__next__) & Struct Operator Overloading ===")
struct Vec2 {
    x,
    y
}

impl Vec2 {
    fn __add__(self, other) {
        return Vec2(self.x + other.x, self.y + other.y)
    }
    fn __mul__(self, scalar) {
        return Vec2(self.x * scalar, self.y * scalar)
    }
    fn __eq__(self, other) {
        return self.x == other.x and self.y == other.y
    }
    fn __str__(self) {
        return f"Vec2({self.x}, {self.y})"
    }
}

let p = (Vec2(2, 3) + Vec2(4, 5)) * 2
print("Struct operator result:", str(p), "equals Vec2(12, 16):", p == Vec2(12, 16))

struct Countdown {
    n
}

impl Countdown {
    fn __next__(self) {
        if self.n <= 0 {
            return nil
        }
        let v = self.n
        self.n = self.n - 1
        return v
    }
}

let countdown_items = Countdown(5).map(|x| x * 100)
print("Custom struct iterator .map():", countdown_items)

print("\n=== 9. Language-Level Unit Tests & Property Fuzzing ===")
test "vector algebra invariant" {
    assert_eq(Vec2(1, 2) + Vec2(3, 4), Vec2(4, 6))
}

let prop_ok = Fuzz.check(|a, b| (a + b) == (b + a), 50)
print("Fuzz.check commutativity:", prop_ok, "Test summary:", Test.summary())

print("\n=== 10. Bytecode Disassembler & Introspection ===")
print("Bytecode stats for compute_metric:", Bytecode.stats(compute_metric))

