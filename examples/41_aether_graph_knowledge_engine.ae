# ==============================================================================
# Example 41: AetherGraph — Native Property Graph & Knowledge Traversal Engine
# In-Memory Graph Database, Shortest Path, PageRank & Hybrid Vector Traversal
# ==============================================================================

import aether_graph

print("================================================================================")
print("🕸️ AETHERGRAPH: NATIVE PROPERTY GRAPH & KNOWLEDGE TRAVERSAL ENGINE")
print("================================================================================")

# 1. Initialize Knowledge Graph
let kg = aether_graph.Graph("AetherAI_Knowledge_Graph")
print("\n[Step 1] Initialized Knowledge Graph:", kg.name)

# 2. Add Conceptual Nodes with Metadata & Vector Embeddings
# Concept vectors: [AI_focus, Systems_focus, Hardware_focus]
let n_transformer = kg.add_node("Transformer Architecture", {
    "category": "Deep Learning",
    "year": 2017
}, [0.95, 0.20, 0.10])

let n_llm = kg.add_node("Large Language Models", {
    "category": "GenAI",
    "year": 2020
}, [0.92, 0.35, 0.15])

let n_rag = kg.add_node("Retrieval-Augmented Generation", {
    "category": "Knowledge AI",
    "year": 2022
}, [0.88, 0.50, 0.10])

let n_agent = kg.add_node("Autonomous Multi-Agent Swarm", {
    "category": "Agency",
    "year": 2024
}, [0.96, 0.65, 0.20])

let n_cuda = kg.add_node("CUDA Hardware Acceleration", {
    "category": "Systems & GPU",
    "year": 2006
}, [0.30, 0.90, 0.95])

let n_runtime = kg.add_node("Aether High-Performance VM", {
    "category": "Execution Engine",
    "year": 2026
}, [0.70, 0.95, 0.60])

print("  ✓ Registered 6 Knowledge Nodes with Properties & Embeddings")

# 3. Add Directed Semantic Edges with Weights (Traversal Cost)
kg.add_edge(n_transformer, n_llm, "ENABLES", 1.2, {"confidence": 0.99})
kg.add_edge(n_llm, n_rag, "AUGMENTED_BY", 1.5, {"confidence": 0.95})
kg.add_edge(n_rag, n_agent, "EMPOWERS", 1.1, {"confidence": 0.98})
kg.add_edge(n_cuda, n_transformer, "ACCELERATES", 2.0, {"confidence": 0.90})
kg.add_edge(n_runtime, n_agent, "ORCHESTRATES", 1.3, {"confidence": 0.97})
kg.add_edge(n_cuda, n_runtime, "POWERS", 1.0, {"confidence": 0.99})

print("  ✓ Created 6 Directed Weighted Semantic Edges")

# 4. Dijkstra Shortest Multi-Hop Path
print("\n[Step 2] Executing Dijkstra Shortest Path (CUDA -> Autonomous Agents):")
let route = kg.shortest_path(n_cuda, n_agent)
if route != nil:
    print("  Optimal Path Node IDs:", route["path"])
    print("  Cumulative Traversal Cost:", route["cost"])
    print("  ✓ Verified lowest-latency knowledge path found")
else:
    print("  No path found!")

# 5. PageRank Authority Convergence
print("\n[Step 3] Computing Graph-Wide PageRank (Centrality & Influence):")
let ranks = kg.pagerank(25, 0.85)
print("  PageRank distribution calculated across nodes.")
for nid in [n_transformer, n_llm, n_agent, n_runtime]:
    print("  Node ID:", nid, "-> Rank Score:", ranks[str(nid)])

# 6. Breadth-First & Depth-First Neighborhood Search
print("\n[Step 4] Exploring BFS Neighborhood from Transformer (depth=2):")
let bfs_nodes = kg.bfs(n_transformer, 2)
print("  BFS Visited Nodes:", bfs_nodes)

let dfs_nodes = kg.dfs(n_transformer, 2)
print("  DFS Visited Nodes:", dfs_nodes)

# 7. Vector Semantic Search + Graph Traversal
print("\n[Step 5] Hybrid Semantic Query ('Autonomous Systems & Agents'):")
# Query vector close to Agent & Systems: [0.90, 0.60, 0.20]
let query_vec = [0.90, 0.60, 0.20]
let matches = kg.semantic_search(query_vec, 3)
print("  Top 3 Semantic Matches in Graph:")
for hit in matches:
    print("    - Node", hit["node_id"], ":", hit["label"], "| Cosine Similarity:", hit["score"])

print("\n================================================================================")
print("✨ AETHERGRAPH DEMONSTRATION COMPLETE: 100% OPERATIONAL")
print("================================================================================")
