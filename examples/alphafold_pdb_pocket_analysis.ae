// ==============================================================================
// AETHER Structural Biology: AlphaFold & 3D PDB Pocket Analyzer
// Evaluates macromolecular topology, pLDDT confidence, and drug contact residues
// ==============================================================================

println("================================================================================")
println("🔬 AETHER STRUCTURAL BIOLOGY: ALPHAFOLD & 3D PDB POCKET ANALYSIS")
println("================================================================================")

let pdb_path = "data/kras_g12d_pocket.pdb"
println("Loading macromolecular structure: " + pdb_path)

let mol_struct = Bio.Structure(pdb_path)

println("\n[1. Topology & Coordinate Metrics]")
println("  Title:              " + mol_struct.title)
println("  Total Atoms:        " + to_string(mol_struct.atom_count()))
println("  Protein Residues:   " + to_string(mol_struct.residue_count()))
println("  Active Chains:      " + to_string(mol_struct.chains()))

let c = mol_struct.centroid()
println("  Center of Mass:     (" + to_string(c[0]) + ", " + to_string(c[1]) + ", " + to_string(c[2]) + ") Å")
println("  Radius of Gyration: " + to_string(mol_struct.radius_of_gyration()) + " Å")

println("\n[2. AlphaFold Structural Confidence (pLDDT)]")
let plddt = mol_struct.plddt_summary()
println("  Mean pLDDT Score:   " + to_string(plddt.mean) + " / 100")
println("  Score Range:        [" + to_string(plddt.min) + " - " + to_string(plddt.max) + "]")
println("  Confident Residues: " + to_string(plddt.confident_percent) + "%")
println("  Assessment:         " + plddt.confidence_category)

println("\n[3. Inhibitor Binding Pocket Residues (MRTX1133 - 4.0 Å Cutoff)]")
let pocket = mol_struct.ligand_pocket("MRT", 4.0)

println(f"Discovered {pocket.len()} contact residues in KRAS G12D Switch-II pocket:")
println("--------------------------------------------------------------------------------")
println("Residue    Chain    Seq No    Distance (Å)    Interaction Type")
println("--------------------------------------------------------------------------------")

for i in 0..pocket.len() {
    let r = pocket[i]
    let int_type = "Van der Waals Contact"
    if r.res_name == "ASP" && r.res_seq == 12 {
        int_type = "Salt Bridge / Polar (Mutant Specific Target)"
    } else if r.distance < 3.2 {
        int_type = "Hydrogen Bond / Close Polar"
    }
    
    println(f"{r.res_name:<10} {r.chain:<8} {r.res_seq:<9} {r.distance:<15} {int_type}")
}
println("--------------------------------------------------------------------------------")
println("Analysis complete: High-affinity binding pocket verified around Oncogenic Asp12.")
