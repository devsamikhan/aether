{
  "name": "aether-language-support",
  "displayName": "AETHER Language Support",
  "description": "Official syntax highlighting, snippets, and tools for the AETHER programming language.",
  "version": "2.0.0",
  "publisher": "devsamikhan",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "aether",
        "aliases": [
          "AETHER",
          "aether"
        ],
        "extensions": [
          ".ae",
          ".aether"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aether",
        "scopeName": "source.aether",
        "path": "./syntaxes/aether.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aether",
        "path": "./snippets/aether.json"
      }
    ]
  }
}
