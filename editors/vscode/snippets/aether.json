{
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) {",
      "\t${0:# body}",
      "}"
    ],
    "description": "Define a function in AETHER"
  },
  "Class Definition": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName} {",
      "\tfn init(${2:params}) {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Define a class in AETHER"
  },
  "Intent Block": {
    "prefix": "intent",
    "body": [
      "intent ${1:ContractName} {",
      "\trequire: ${2:condition}",
      "\tensure: ${3:condition}",
      "\t${0}",
      "}"
    ],
    "description": "Define a declarative intent contract"
  },
  "Database Connect": {
    "prefix": "db_open",
    "body": [
      "let db = DB.open(\"${1::memory:}\")",
      "db.execute(\"CREATE TABLE ${2:table_name} (${3:id INT, name TEXT});\")",
      "${0}"
    ],
    "description": "Open relational database and create table"
  },
  "AI Autonomous Agent": {
    "prefix": "ai_agent",
    "body": [
      "let agent = AI.agent(\"${1:AgentName}\", \"${2:RoleDescription}\")",
      "let response = AI.ask(agent, \"${3:Task prompt}\")",
      "println(response)",
      "${0}"
    ],
    "description": "Spawn an autonomous AI Agent"
  },
  "Material 3 Card": {
    "prefix": "m3_card",
    "body": [
      "let card = M3.card(\"${1|elevated,filled,outlined|}\", \"${2:Title}\", \"${3:Subtitle}\", \"${4:Content}\")",
      "M3.render_preview(card)",
      "${0}"
    ],
    "description": "Create and render a Material 3 Card"
  },
  "Mobile Toast": {
    "prefix": "toast",
    "body": [
      "Mobile.show_toast(\"${1:Message}\")",
      "${0}"
    ],
    "description": "Show native Android toast"
  }
}
