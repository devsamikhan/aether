{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AETHER",
  "scopeName": "source.aether",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.aether",
          "match": "#.*$"
        },
        {
          "name": "comment.block.aether",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fstring.aether",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aether",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.expression.aether",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.aether",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aether",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.aether",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.aether",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.aether",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.aether",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aether",
          "match": "\\b(if|elif|else|while|for|in|return|break|continue|spawn|await|match)\\b"
        },
        {
          "name": "keyword.declaration.aether",
          "match": "\\b(let|mut|fn|class|struct|intent|require|ensure|type)\\b"
        },
        {
          "name": "variable.language.this.aether",
          "match": "\\bthis\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.class.aether",
          "match": "\\b(DB|Database|AI|Mobile|M3|Quantum|Fiber|Simd|File|Net|Crypto|Tensor|DataFrame|Strings|Math)\\b"
        },
        {
          "name": "support.function.builtin.aether",
          "match": "\\b(print|println|input|len|push|pop|insert|remove|clear|to_string|to_int|to_float|range|assert|type_of|clock|time|time_ms|sleep_ms)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.aether",
          "match": "\\b(true|false|True|False)\\b"
        },
        {
          "name": "constant.language.nil.aether",
          "match": "\\b(nil|null|None)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.aether",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.aether",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.aether",
          "match": "\\+|-|\\*|/|%|\\|>"
        },
        {
          "name": "keyword.operator.assignment.aether",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.aether",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
